VPATH=@VPATH@
PKGNAME=@PKGNAME@
VERSION=@VERSION@
INSTALL_PROGRAM=@INSTALL_PROGRAM@
INSTALL_SCRIPT=@INSTALL_SCRIPT@
.PHONY: all install uninstall clean mrproper
CXX=@CXX@
CXXFLAGS=@CXXFLAGS@
CPPFLAGS=@CPPFLAGS@
LDFLAGS=@LDFLAGS@
SRCS=@SRCS@

prefix=@PREFIX@
BINDIR?=@BINDIR@


OBJS=$(SRCS:.cc=.o)

all: $(PKGNAME)

$(PKGNAME): $(OBJS)
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) -o $@ $(OBJS) $(LDFLAGS)

.cc.o:
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) -c $<

install: all
	mkdir -p $(DESTDIR)$(BINDIR)
	$(INSTALL_PROGRAM) $(PKGNAME) $(DESTDIR)$(BINDIR)
	$(INSTALL_SCRIPT) ../tuduconvert $(DESTDIR)$(BINDIR)/tuduconvert

clean:
	@rm -f $(PKGNAME) $(OBJS) core tags

mrproper: clean
	rm -f Makefile defs.h

uninstall:
	rm -f $(DESTDIR)$(BINDIR)/$(PKGNAME)
	rm -f $(DESTDIR)$(BINDIR)/tuduconvert
